SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host:5432/contract_analyzer_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-your-password

CORS_ALLOWED_ORIGINS=https://your-client-domain.com
OPENAPI_SERVER_URL=https://your-server-domain.com
OPENAPI_SERVER_DESCRIPTION=Production server

FILE_UPLOAD_DIR=uploads/

JWT_SECRET_KEY=replace-with-a-long-random-secret-key-at-least-32-characters

HUGGINGFACE_API_URL=https://router.huggingface.co/hf-inference/models/facebook/bart-large-cnn
HUGGINGFACE_API_TOKEN=replace-with-your-token
HUGGINGFACE_CONNECT_TIMEOUT_MS=5000
HUGGINGFACE_READ_TIMEOUT_MS=30000
HUGGINGFACE_MAX_ATTEMPTS=3
HUGGINGFACE_RETRY_BACKOFF_MS=750
